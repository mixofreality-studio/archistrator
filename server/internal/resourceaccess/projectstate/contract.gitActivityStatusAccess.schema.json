{
  "$id": "archistrator://contract/projectstate/gitactivitystatus",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gitActivityStatusAccess contract",
  "interface": {
    "name": "GitActivityStatusAccess",
    "layer": "resourceaccess",
    "operations": [
      {
        "name": "RecordActivityBranchOpened",
        "params": [
          {"name": "projectID", "schema": {"$ref": "#/$defs/ProjectID"}},
          {"name": "expectedVersion", "schema": {"$ref": "#/$defs/Version"}},
          {"name": "activityID", "schema": {"type": "string"}},
          {"name": "branch", "schema": {"type": "string"}},
          {"name": "branchRef", "schema": {"type": "string"}},
          {"name": "prRef", "schema": {"type": "string"}},
          {"name": "crLabel", "schema": {"type": "string"}},
          {"name": "isRevert", "schema": {"type": "boolean"}},
          {"name": "cred", "schema": {"$ref": "#/$defs/RepoCredential"}},
          {"name": "idempotencyKey", "schema": {"x-go-type": "fwra.IdempotencyKey"}}
        ],
        "result": {"$ref": "#/$defs/Version"},
        "error": true
      },
      {
        "name": "RecordActivityCIObserved",
        "params": [
          {"name": "projectID", "schema": {"$ref": "#/$defs/ProjectID"}},
          {"name": "expectedVersion", "schema": {"$ref": "#/$defs/Version"}},
          {"name": "activityID", "schema": {"type": "string"}},
          {"name": "ci", "schema": {"$ref": "#/$defs/CICheckState"}},
          {"name": "cred", "schema": {"$ref": "#/$defs/RepoCredential"}},
          {"name": "idempotencyKey", "schema": {"x-go-type": "fwra.IdempotencyKey"}}
        ],
        "result": {"$ref": "#/$defs/Version"},
        "error": true
      },
      {
        "name": "RecordActivityArchApproved",
        "params": [
          {"name": "projectID", "schema": {"$ref": "#/$defs/ProjectID"}},
          {"name": "expectedVersion", "schema": {"$ref": "#/$defs/Version"}},
          {"name": "activityID", "schema": {"type": "string"}},
          {"name": "cred", "schema": {"$ref": "#/$defs/RepoCredential"}},
          {"name": "idempotencyKey", "schema": {"x-go-type": "fwra.IdempotencyKey"}}
        ],
        "result": {"$ref": "#/$defs/Version"},
        "error": true
      },
      {
        "name": "RecordActivityMerged",
        "params": [
          {"name": "projectID", "schema": {"$ref": "#/$defs/ProjectID"}},
          {"name": "expectedVersion", "schema": {"$ref": "#/$defs/Version"}},
          {"name": "activityID", "schema": {"type": "string"}},
          {"name": "cred", "schema": {"$ref": "#/$defs/RepoCredential"}},
          {"name": "idempotencyKey", "schema": {"x-go-type": "fwra.IdempotencyKey"}}
        ],
        "result": {"$ref": "#/$defs/Version"},
        "error": true
      },
      {
        "name": "RecordActivityStarted",
        "params": [
          {"name": "projectID", "schema": {"$ref": "#/$defs/ProjectID"}},
          {"name": "expectedVersion", "schema": {"$ref": "#/$defs/Version"}},
          {"name": "activityID", "schema": {"type": "string"}},
          {"name": "cred", "schema": {"$ref": "#/$defs/RepoCredential"}},
          {"name": "idempotencyKey", "schema": {"x-go-type": "fwra.IdempotencyKey"}}
        ],
        "result": {"$ref": "#/$defs/Version"},
        "error": true
      },
      {
        "name": "RecordActivityCompleted",
        "params": [
          {"name": "projectID", "schema": {"$ref": "#/$defs/ProjectID"}},
          {"name": "expectedVersion", "schema": {"$ref": "#/$defs/Version"}},
          {"name": "activityID", "schema": {"type": "string"}},
          {"name": "cred", "schema": {"$ref": "#/$defs/RepoCredential"}},
          {"name": "idempotencyKey", "schema": {"x-go-type": "fwra.IdempotencyKey"}}
        ],
        "result": {"$ref": "#/$defs/Version"},
        "error": true
      }
    ]
  },
  "$defs": {
    "ProjectID": {
      "type": "string"
    },
    "Version": {
      "type": "integer"
    },
    "RepoCredential": {
      "type": "object",
      "properties": {
        "Bytes": {
          "type": "string",
          "contentEncoding": "base64",
          "x-go-type": "[]byte"
        },
        "ExpiresAt": {
          "type": "string",
          "format": "date-time",
          "x-go-import": "time",
          "x-go-type": "time.Time"
        }
      },
      "required": [
        "Bytes",
        "ExpiresAt"
      ],
      "additionalProperties": false
    },
    "CICheckState": {
      "type": "integer",
      "enum": [
        0,
        1,
        2
      ],
      "x-enum-varnames": [
        "CICheckPending",
        "CICheckSuccess",
        "CICheckFailure"
      ],
      "x-go-base": "int"
    }
  }
}
